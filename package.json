{
  "name": "obsidian-zagent",
  "version": "0.1.0",
  "private": true,
  "description": "Launch local AI agents with the current Obsidian note as context",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:terminal": "tsx scripts/smoke-terminal.ts",
    "package": "npm run build && node scripts/package.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
